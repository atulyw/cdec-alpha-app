// Auth service pipeline — build, test, SonarCloud, Docker, ECR, EKS
//
// Jenkins agent needs: Java 17, Docker, AWS CLI, kubectl
//
// Jenkins credentials (Manage Jenkins → Credentials):
//   sonarcloud-token        — Secret text: SonarCloud user token (SONAR_TOKEN)
//   sonarcloud-organization — Secret text: SonarCloud organization key
//   sonarcloud-project-key  — Secret text: SonarCloud project key for auth-service
//   aws-frontend-terraform  — AWS access key for ECR/EKS
//
// EKS access: IAM principal must be in infrastructure/backend terraform.tfvars
//   include_caller_as_cluster_admin (see backend README — kubectl access)

pipeline {
    agent {
        label 'terraform'
    }

    environment {
        APP_DIR      = 'application/backend/auth-service'
        EKS_CLUSTER  = 'cdec-eks-dev'
        EKS_REGION   = 'eu-west-1'
        ECR_REGISTRY = '933516006319.dkr.ecr.eu-west-1.amazonaws.com'
        IMAGE        = '933516006319.dkr.ecr.eu-west-1.amazonaws.com/backend/auth-service:latest'
    }

    stages {

        stage('Checkout') {
            steps {
                git url: 'https://github.com/atulyw/cdec-alpha-app.git', branch: 'main'
            }
        }

        // verify = compile + unit tests + JaCoCo XML (target/site/jacoco/jacoco.xml)
        stage('Build and Unit Tests') {
            steps {
                dir(env.APP_DIR) {
                    sh './mvnw -B clean verify'
                }
            }
        }

        // Uploads sources, test results, and JaCoCo coverage to SonarCloud
        stage('SonarCloud Analysis') {
            steps {
                dir(env.APP_DIR) {
                    // Full git history improves SonarCloud blame and issue tracking
                    sh 'git fetch --unshallow 2>/dev/null || true'
                    withCredentials([
                        string(credentialsId: 'sonarcloud-token', variable: 'SONAR_TOKEN'),
                        string(credentialsId: 'sonarcloud-organization', variable: 'SONAR_ORGANIZATION'),
                        string(credentialsId: 'sonarcloud-project-key', variable: 'SONAR_PROJECT_KEY'),
                    ]) {
                        sh '''
                            ./mvnw -B org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                                -Dsonar.organization="${SONAR_ORGANIZATION}" \
                                -Dsonar.projectKey="${SONAR_PROJECT_KEY}"
                        '''
                    }
                }
            }
        }

        stage('Build Docker image') {
            agent {
                label 'master'
            }
            steps {
                dir(env.APP_DIR) {
                    sh "docker build -t ${IMAGE} ."
                }
            }
        }

        stage('Push to ECR') {
            agent {
                label 'master'
            }
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-frontend-terraform',
                    accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                    secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                ]]) {
                    sh """
                        export AWS_DEFAULT_REGION=${EKS_REGION}
                        aws ecr get-login-password --region ${EKS_REGION} | \\
                            docker login --username AWS --password-stdin ${ECR_REGISTRY}
                        docker push ${IMAGE}
                    """
                }
            }
        }

        stage('Deploy to EKS') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-frontend-terraform',
                    accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                    secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                ]]) {
                    dir(env.APP_DIR) {
                        sh """
                            export AWS_DEFAULT_REGION=${EKS_REGION}
                            aws eks update-kubeconfig --region ${EKS_REGION} --name ${EKS_CLUSTER}

                            kubectl apply -f k8s/deployment.yml -n default
                            kubectl rollout restart deployment/auth-service -n default
                            kubectl rollout status deployment/auth-service -n default --timeout=300s
                        """
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'auth-service built, analyzed, and deployed successfully!'
        }
        failure {
            echo 'auth-service pipeline failed. Check the stage logs above.'
        }
    }
}
